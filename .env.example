DATABASE_URL="your pooled PostgreSQL connection"
DIRECT_URL="your direct PostgreSQL connection"

# Used to open /admin and authorize email broadcasts.
ADMIN_EMAIL_SECRET="replace-with-a-long-random-password"

# Gmail requires a 16-character App Password, not your regular password.
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_app_password"
